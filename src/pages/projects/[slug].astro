---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { projects } from '../../data/site';
export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, i, next: projects[(i + 1) % projects.length] },
  }));
}
const { p, i, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={p.title} description={p.summary} progress>
  <article class="case" style={`--h:${(i * 130 + 250) % 360}`}>
    <a class="back" href={`${base}#projects`}><span aria-hidden="true">←</span> Back to projects</a>
    <Cover p={p} i={i} large />
    <header class="case-head">
      <h1>{p.title}</h1>
      {p.tagline && <p class="tagline">{p.tagline}</p>}
      <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
      <div class="links">
        {p.repo && <a class="ghost" href={p.repo} target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>}
        {p.demo && <a class="ghost" href={p.demo} target="_blank" rel="noopener noreferrer">Live demo <span aria-hidden="true">↗</span></a>}
        {!p.repo && !p.demo && <span class="meta">Source and live demo links are coming soon.</span>}
      </div>
    </header>

    {p.problem && (
      <section>
        <h2 class="label reveal">Overview</h2>
        <p class="reveal">{p.problem}</p>
        {p.roles && (
          <div class="roles reveal">
            <span class="meta">Roles in the system</span>
            <ul class="tags">{p.roles.map((r) => <li>{r}</li>)}</ul>
          </div>
        )}
      </section>
    )}

    {p.highlights && (
      <section>
        <h2 class="label reveal">Key highlights</h2>
        <ul class="hl-grid">
          {p.highlights.map((h, n) => (
            <li class="hl reveal" style={`--d:${n}`}>
              <span class="num">{String(n + 1).padStart(2, '0')}</span>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {p.flow && (
      <section>
        <h2 class="label reveal">How it works</h2>
        <ol class="flow">
          {p.flow.map((s, n) => (
            <li class="step reveal" style={`--d:${n}`}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {p.decisions && (
      <section>
        <h2 class="label reveal">Decisions</h2>
        <ul class="dec">{p.decisions.map((d, n) => <li class="reveal" style={`--d:${n}`}>{d}</li>)}</ul>
      </section>
    )}

    {next.slug !== p.slug && (
      <a class="next reveal" href={`${base}projects/${next.slug}`}>
        <span class="meta">Next project</span>
        <span class="next-title">{next.title} <span class="arr" aria-hidden="true">→</span></span>
      </a>
    )}
  </article>
</Base>
