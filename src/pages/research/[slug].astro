---
import Base from '../../layouts/Base.astro';
import ResearchCover from '../../components/ResearchCover.astro';
import { research } from '../../data/site';
export function getStaticPaths() {
  return research.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const total = r.buckets.reduce((s, b) => s + b.n, 0);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={r.title} description={r.summary} progress>
  <article class="case" style="--h:165">
    <a class="back" href={`${base}#research`}><span aria-hidden="true">←</span> Back to research</a>
    <ResearchCover slug={r.slug} large badge={r.kind} />
    <header class="case-head">
      <h1>{r.title}</h1>
      <p class="tagline">{r.tagline}</p>
      <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>
      <div class="links">
        <span class="meta">{r.kind} at {r.org}.</span>
        <a class="ghost" href={r.url} target="_blank" rel="noopener noreferrer">Visit {r.org} <span aria-hidden="true">↗</span></a>
        {r.repo && <a class="ghost" href={r.repo} target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>}
      </div>
    </header>

    <section>
      <ul class="stats">
        {r.stats.map((s, n) => (
          <li class="stat reveal" style={`--d:${n}`}><b>{s.value}</b><span>{s.label}</span></li>
        ))}
      </ul>
    </section>

    {r.sections.map((sec) => (
      <section>
        <h2 class="label reveal">{sec.title}</h2>
        {sec.paras?.map((t) => <p class="reveal">{t}</p>)}

        {sec.id === 'compare' && (
          <div class="viz reveal">
            <p class="meta">Tone error over the full pool (lower is better)</p>
            <div class="bars">
              <div class="bar"><span>Baseline</span><span class="track"><span class="fill" style={`--w:${r.toneError.a}%`}></span></span><b>{r.toneError.a}%</b></div>
              <div class="bar"><span>Tuned</span><span class="track"><span class="fill" style={`--w:${r.toneError.b}%`}></span></span><b>{r.toneError.b}%</b></div>
            </div>
            <p class="meta" style="margin-top:1.5rem">The {total} curated queries</p>
            <div class="seg-bar" role="img" aria-label={r.buckets.map((b) => `${b.label}: ${b.n}`).join(', ')}>
              {r.buckets.map((b) => <span class={`seg ${b.tone}`} style={`flex:${b.n}`}></span>)}
            </div>
            <ul class="legend">{r.buckets.map((b) => <li class={b.tone}><i></i>{b.label}: {b.n}</li>)}</ul>
          </div>
        )}

        {sec.id === 'math' && (
          <pre class="formula reveal" tabindex="0" aria-label="Supervised contrastive loss formula"><code>{r.formula}</code></pre>
        )}

        {sec.items && (
          <ul class="dec">
            {sec.items.map((it, n) => <li class="reveal" style={`--d:${n}`}><strong>{it.term}.</strong> {it.text}</li>)}
          </ul>
        )}
      </section>
    ))}

    <section>
      <h2 class="label reveal">References</h2>
      <ul class="dec">{r.refs.map((x) => <li class="reveal"><strong>{x.cite}.</strong> {x.title}</li>)}</ul>
    </section>
  </article>
</Base>
