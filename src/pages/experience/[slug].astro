---
import Base from '../../layouts/Base.astro';
import { experience } from '../../data/site';
export function getStaticPaths() {
  return experience.map((e, i) => ({
    params: { slug: e.slug },
    props: { e, next: experience[(i + 1) % experience.length] },
  }));
}
const { e, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`${e.role}, ${e.org}`} description={e.summary} progress>
  <article class="case">
    <a class="back" href={`${base}#experience`}><span aria-hidden="true">←</span> Back to experience</a>
    <header class="case-head exp-head">
      <span class="mono lg" aria-hidden="true">{e.mono}</span>
      <h1>{e.role}</h1>
      <p class="tagline">{e.org}, {e.type}</p>
      <p class="meta">{e.when}. {e.place}.</p>
      <div class="links"><a class="ghost" href={e.url} target="_blank" rel="noopener noreferrer">Visit {e.org} <span aria-hidden="true">↗</span></a></div>
    </header>
    <section>
      <h2 class="label reveal">Overview</h2>
      <p class="reveal">{e.overview ?? e.summary}</p>
    </section>
    <section>
      <h2 class="label reveal">What I did</h2>
      <ul class="dec">{e.points.map((t, n) => <li class="reveal" style={`--d:${n}`}>{t}</li>)}</ul>
    </section>
    <section>
      <h2 class="label reveal">Skills used</h2>
      <ul class="tags reveal">{e.skills.map((s) => <li>{s}</li>)}</ul>
    </section>
    {next.slug !== e.slug && (
      <a class="next reveal" href={`${base}experience/${next.slug}`}>
        <span class="meta">Also at {next.org}</span>
        <span class="next-title">{next.role} <span class="arr" aria-hidden="true">→</span></span>
      </a>
    )}
  </article>
</Base>
