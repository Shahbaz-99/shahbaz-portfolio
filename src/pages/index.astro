---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResearchCard from '../components/ResearchCard.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import { site, projects, experience, education, research, skills, aiWork } from '../data/site';
const stack = skills.flatMap((s) => s.items).join(', ');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const heroStats = [
  { value: 'Jan 2025', detail: 'At Ethical Intelligence' },
  { value: '3', detail: 'Projects built' },
  { value: 'Python · Django · DRF', detail: 'Core stack' },
];
const services = [
  { title: 'Backend & API Development', description: 'REST APIs with Django and DRF, authentication and authorization.' },
  { title: 'Database Design', description: 'MySQL schema design and data modelling.' },
  { title: 'Docker, CI/CD & Monitoring', description: 'Docker, CI/CD, Kubernetes (basics), Prometheus.' },
  { title: 'AI Exploration', description: 'RAG, embeddings and NLP, integrating AI into real software.' },
];
const processSteps = [
  {
    title: 'Specify',
    description: 'Requirements and specifications drive the work.',
    icon: '<path d="M7 3.75h7l4 4V20.25H7z"/><path d="M14 3.75v4h4M10 12h5M10 15.5h5"/>',
  },
  {
    title: 'Design',
    description: 'OOP and SOLID principles, API and database design.',
    icon: '<path d="m14.5 5.5 4 4M5 19l4.5-1 9-9a2.12 2.12 0 0 0-3-3l-9 9z"/><path d="M5 19h14"/>',
  },
  {
    title: 'Build',
    description: 'Clean, maintainable code, tested with Postman.',
    icon: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  },
  {
    title: 'Ship',
    description: 'Docker, Git/GitHub workflow, CI/CD.',
    icon: '<path d="M4 15.5c4.5 0 8-3.5 8-8V4c4.5 1 7 4.5 7 9l-4 4H9z"/><path d="M8 16.5 6 20l4-1M16 9h.01M4 12l-1 3 4-1"/>',
  },
];
---
<Base homepage>
  <section id="top" class="hero">
    <div class="hero-copy">
      <div class="hero-top">
        <div class="status-pill" aria-label="Availability status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Open to internships &amp; job opportunities</span>
        </div>
      </div>
      <div class="greet">
        <h1 class="hello">{site.name.split(' ')[0]} here!</h1>
        <span class="clock" data-clock-wrap aria-hidden="true"><span data-clock={site.timezone}></span> {site.tzLabel}</span>
      </div>
      <p class="hero-headline">{site.headline}</p>
      <p>{site.description}</p>
      <p>Currently contributing as a Backend Developer Intern at <a class="lnk" href={experience[0].url}>{experience[0].org}</a>, where the focus is on developing and maintaining REST APIs, implementing authentication and authorization mechanisms, and containerizing applications using Docker.</p>
      <p>Strong interest in backend development, problem-solving, and building reliable software solutions. I also enjoy AI-related research.</p>
      <div class="hero-cta-group">
        <div class="hero-btns">
          <a class="btn-primary" href="#projects">Explore Projects ↓</a>
          {site.linkedin && <a class="btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
        </div>
        <div class="chips">
          <a class="chip" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
          {site.linkedin && <a class="chip" href={site.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /></a>}
          <a class="chip" href={site.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer"><Icon name="code" /></a>
          {site.resumeUrl && <a class="chip" href={site.resumeUrl} aria-label="Resume (PDF)"><Icon name="file" /></a>}
        </div>
      </div>
      <ul class="hero-stats" aria-label="Career and project highlights">
        {heroStats.map((stat) => (
          <li class="hero-stat">
            <strong>{stat.value}</strong>
            <span>{stat.detail}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero-visual">
      <div class="hero-blob hero-blob-pink" aria-hidden="true"></div>
      <div class="hero-blob hero-blob-mint" aria-hidden="true"></div>
      <div class="hero-blob hero-blob-peach" aria-hidden="true"></div>
      <div class="polaroid">
        {site.photo ? <img src={`${base}${site.photo.replace(/^\//, '')}`} alt={`Portrait of ${site.name}`} width="76" height="76" /> : <span class="ph" aria-hidden="true">{site.initials}</span>}
      </div>
    </div>
  </section>

  <section id="projects" class="block home-projects" aria-labelledby="h-projects">
    <h2 class="label reveal" id="h-projects">Best projects</h2>
    <div class="cards">{projects.map((p, i) => <ProjectCard p={p} i={i} />)}</div>
    <div class="reveal"><GitHubActivity /></div>
  </section>

  <section id="experience" class="block home-band" aria-labelledby="h-exp">
    <h2 class="label reveal" id="h-exp">Experience</h2>
    <ul class="tl">
      {experience.map((t, n) => (
        <li class="reveal" style={`--d:${n}`}>
          <span class="mono" aria-hidden="true">{t.mono}</span>
          <a class="tl-body" href={`${base}experience/${t.slug}`}>
            <span class="top">
              <span class="name">{t.org}</span>
              <span class="when">{t.when}</span>
            </span>
            <span class="role">{t.role}</span>
            <span class="txt">{t.summary}</span>
            <span class="go">View details <i aria-hidden="true">→</i></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="meta reveal">Stack: {stack}</p>
    <div class="skills-overview reveal">
      <h3 class="skills-title">Technical Skills</h3>
      <div class="skills-grid">
        {skills.map((s) => (
          <div class="skill-category">
            <span class="skill-label">{s.group}</span>
            <div class="skill-tags">
              {s.items.map((it) => (
                <span class="skill-tag">{it}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="block home-band" aria-labelledby="h-edu">
    <h2 class="label reveal" id="h-edu">Education</h2>
    <ul class="tl">
      {education.map((t) => (
        <li class="reveal">
          <span class="mono" aria-hidden="true">{t.mono}</span>
          <div>
            <div class="top"><span class="name">{t.name}</span><span class="when">{t.when}</span></div>
            <div class="role">{t.degree}</div>
            <p>{t.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="research" class="block home-research" aria-labelledby="h-research">
    <h2 class="label reveal" id="h-research">Research</h2>
    <p class="empty reveal">I enjoy AI-related research, especially digging into how models behave and why.</p>
    <div class="cards">{research.map((r, i) => <ResearchCard r={r} i={i} />)}</div>
    {aiWork.length > 0 && (
      <ul class="list">
        {aiWork.map((a) => (
          <li class="reveal">
            <div class="line">{a.href ? <a href={a.href}>{a.title} {'\u2197'}</a> : <span>{a.title}</span>}</div>
            <p class="desc">{a.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="what-i-do" class="block home-services" aria-labelledby="h-services">
    <div class="home-section-heading">
      <h2 class="label" id="h-services">What I do</h2>
    </div>
    <div class="service-list">
      {services.map((service, index) => (
        <article class:list={['service-card', { 'service-card-featured': index === 0 }]}>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="process" class="block home-process" aria-labelledby="h-process">
    <div class="home-section-heading">
      <h2 class="label" id="h-process">Work process</h2>
      <p>Requirements and specifications drive the work.</p>
    </div>
    <ol class="process-grid">
      {processSteps.map((step, index) => (
        <li class="process-card">
          <span class="process-number">{index + 1}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={step.icon}></svg>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="home-contact-cta" aria-labelledby="h-contact-cta">
    <div class="home-contact-cta-inner">
      <h2 id="h-contact-cta">Have a project or opportunity in mind? Let's talk.</h2>
      <a class="btn-light" href="#contact">Contact <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="contact" class="block home-contact" aria-labelledby="h-contact">
    <div class="contact-card">
      <div class="contact-details">
        <h2 class="label" id="h-contact">Contact</h2>
        <p class="contact-intro">Have a project or opportunity in mind? Let's talk.</p>
        <ul class="contact-list">
          <li>
            <span class="contact-icon"><Icon name="mail" /></span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          {site.linkedin && (
            <li>
              <span class="contact-icon"><Icon name="linkedin" /></span>
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </li>
          )}
          <li>
            <span class="contact-icon"><Icon name="code" /></span>
            <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </li>
          <li>
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </span>
            <span>Greater Bhopal Area India</span>
          </li>
        </ul>
        <nav class="contact-socials" aria-label="Social links">
          <a class="chip" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
          {site.linkedin && <a class="chip" href={site.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /></a>}
          <a class="chip" href={site.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer"><Icon name="code" /></a>
        </nav>
      </div>
      <form class="contact-form" data-contact-form data-email={site.email}>
        <label for="contact-name">Name*</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
        <label for="contact-email">Email*</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required />
        <label for="contact-subject">Subject*</label>
        <input id="contact-subject" name="subject" type="text" required />
        <label for="contact-message">Message*</label>
        <textarea id="contact-message" name="message" rows="5" required></textarea>
        <button class="btn-primary contact-submit" type="submit">Submit <span aria-hidden="true">→</span></button>
        <p class="contact-note" data-contact-note role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const note = form.querySelector<HTMLElement>('[data-contact-note]');
    const recipient = form.dataset.email;
    if (!note || !recipient) throw new Error('The contact form is missing its status message or email recipient.');

    form.addEventListener('input', (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) field.setCustomValidity('');
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
      fields.forEach((field) => field.setCustomValidity(field.value.trim() ? '' : 'This field is required.'));
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const value = (key: string) => {
        const field = data.get(key);
        if (typeof field !== 'string') throw new Error(`The contact form is missing the ${key} field.`);
        return field.trim();
      };
      const name = value('name');
      const email = value('email');
      const subject = value('subject');
      const message = value('message');
      const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
      note.textContent = 'Your email app should open with the message ready to send.';
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
