---
import type { Project } from '../data/site';
import Cover from './Cover.astro';
const { p, i = 0 } = Astro.props as { p: Project; i?: number };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<a class="card reveal" href={`${base}projects/${p.slug}`} style={`--h:${(i * 130 + 250) % 360};--d:${i}`}>
  <Cover p={p} i={i} />
  <div class="cap">
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <div class="card-pills">
      {p.stack.slice(0, 3).map((s) => <span class="card-pill">{s}</span>)}
      {p.stack.length > 3 && <span class="card-pill more">+{p.stack.length - 3}</span>}
    </div>
    <span class="go">View case study <i aria-hidden="true">→</i></span>
  </div>
</a>
