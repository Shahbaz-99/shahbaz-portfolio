---
import type { Project } from '../data/site';
import Cover from './Cover.astro';
const { p, i = 0 } = Astro.props as { p: Project; i?: number };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<article class="card project-card reveal" style={`--d:${i}`}>
  <Cover p={p} />
  <div class="cap">
    <div class="project-meta">
      <span>Selected work</span>
      {p.year && <span>{p.year}</span>}
    </div>
    <h3><a class="project-title-link" href={`${base}projects/${p.slug}`}>{p.title}</a></h3>
    <p>{p.summary}</p>
    <ul class="card-pills" aria-label="Technology stack">
      {p.stack.map((s) => <li class="card-pill">{s}</li>)}
    </ul>
    <div class="project-actions">
      <a class="go project-detail-link" href={`${base}projects/${p.slug}`}>Case study <span aria-hidden="true">→</span></a>
      {p.repo && <a class="project-source-link" href={p.repo} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
