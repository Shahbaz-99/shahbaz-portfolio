---
import type { Project } from '../data/site';
const { p, large = false } = Astro.props as { p: Project; large?: boolean };
---
<div class={`cover${large ? ' lg' : ''}`} style={`view-transition-name: cover-${p.slug}`}>
  {p.year && <span class="year">{p.year}</span>}
  <div class="mock" aria-hidden="true">
    {p.flow ? (
      <div class="preview-flow">
        <span class="preview-eyebrow">Project workflow</span>
        <ol>
          {p.flow.map((step, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step.title}</strong></li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="preview-records">
        <span class="preview-eyebrow">Employee management</span>
        <div class="preview-record"><span>Employee records</span><i aria-hidden="true">↗</i></div>
        <div class="preview-record"><span>Create · Read · Update · Delete</span><i aria-hidden="true">+</i></div>
        <div class="preview-record"><span>MySQL integration</span><i aria-hidden="true">01</i></div>
      </div>
    )}
  </div>
</div>
