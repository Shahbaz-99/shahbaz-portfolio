---
import type { Project } from '../data/site';
const { p, i = 0, large = false } = Astro.props as { p: Project; i?: number; large?: boolean };
const base = [[70, 52, 62], [58, 74, 46], [66, 44, 72]][i % 3];
const rows = large ? [...base, 56, 68] : base;
---
<div class={`cover${large ? ' lg' : ''}`} style={`view-transition-name: cover-${p.slug}`}>
  {p.year && <span class="year">{p.year}</span>}
  <div class="mock" aria-hidden="true">
    <b></b>
    {rows.map((w) => <div class="mrow"><i style={`width:${w}%`}></i><em></em></div>)}
  </div>
</div>
