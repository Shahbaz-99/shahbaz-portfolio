---
// Animated Red Butterfly Cursor Follower
---

<div class="bf-follower" aria-hidden="true" data-bf-follower>
  <div class="bf-rotator" data-bf-rotator>
    <div class="bf-hover" data-bf-hover>
      <div class="bf-body-wrap">
        <!-- Left Wing -->
        <svg class="bf-wing bf-wing-left" viewBox="0 0 16 22" fill="none">
          <defs>
            <linearGradient id="bf-grad-l" x1="16" y1="11" x2="0" y2="2" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#7a0a14" />
              <stop offset="45%" stop-color="#b81624" />
              <stop offset="100%" stop-color="#e62e3d" />
            </linearGradient>
            <linearGradient id="bf-grad-hind-l" x1="16" y1="11" x2="3" y2="20" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#54070e" />
              <stop offset="60%" stop-color="#9e1320" />
              <stop offset="100%" stop-color="#d42030" />
            </linearGradient>
          </defs>
          <!-- Forewing -->
          <path
            d="M16 11 C14 5, 8 1, 2 2 C-0.8 3.5, 0.5 8, 4 11 C8 13.5, 14 12, 16 11 Z"
            fill="url(#bf-grad-l)"
            stroke="#450409"
            stroke-width="0.5"
          />
          <!-- Hindwing -->
          <path
            d="M16 11 C13 13, 7 15, 3.5 18 C2 20, 5 22, 9 21 C13 19.5, 14.5 15, 16 11 Z"
            fill="url(#bf-grad-hind-l)"
            stroke="#450409"
            stroke-width="0.5"
          />
          <!-- Delicate Veins -->
          <path d="M15 11 C11 7.5, 6 4.5, 2.5 2.5" stroke="#ffa3ab" stroke-width="0.55" stroke-linecap="round" opacity="0.65" />
          <path d="M14 11 C9.5 10, 5 8.5, 2 6" stroke="#ffa3ab" stroke-width="0.45" stroke-linecap="round" opacity="0.55" />
          <path d="M15 11 C11 13.5, 7 16, 4 18" stroke="#ffa3ab" stroke-width="0.5" stroke-linecap="round" opacity="0.6" />
        </svg>

        <!-- Central Body & Antennae -->
        <svg class="bf-body" viewBox="0 0 6 22" fill="none">
          <!-- Antennae -->
          <path d="M2.5 5 C1.5 2.2, 0.6 1.2, 0 1" stroke="#240306" stroke-width="0.6" stroke-linecap="round" />
          <circle cx="0.3" cy="1" r="0.45" fill="#a8111e" />
          <path d="M3.5 5 C4.5 2.2, 5.4 1.2, 6 1" stroke="#240306" stroke-width="0.6" stroke-linecap="round" />
          <circle cx="5.7" cy="1" r="0.45" fill="#a8111e" />
          <!-- Head / Thorax -->
          <ellipse cx="3" cy="6" rx="1.15" ry="1.5" fill="#1c0305" />
          <!-- Abdomen -->
          <ellipse cx="3" cy="13" rx="0.95" ry="5.5" fill="#2d0509" />
          <path d="M2.2 10.5 Q3 11 3.8 10.5 M2.2 13 Q3 13.5 3.8 13 M2.2 15.5 Q3 16 3.8 15.5" stroke="#540810" stroke-width="0.4" opacity="0.7" />
        </svg>

        <!-- Right Wing -->
        <svg class="bf-wing bf-wing-right" viewBox="0 0 16 22" fill="none">
          <defs>
            <linearGradient id="bf-grad-r" x1="0" y1="11" x2="16" y2="2" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#7a0a14" />
              <stop offset="45%" stop-color="#b81624" />
              <stop offset="100%" stop-color="#e62e3d" />
            </linearGradient>
            <linearGradient id="bf-grad-hind-r" x1="0" y1="11" x2="13" y2="20" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#54070e" />
              <stop offset="60%" stop-color="#9e1320" />
              <stop offset="100%" stop-color="#d42030" />
            </linearGradient>
          </defs>
          <!-- Forewing -->
          <path
            d="M0 11 C2 5, 8 1, 14 2 C16.8 3.5, 15.5 8, 12 11 C8 13.5, 2 12, 0 11 Z"
            fill="url(#bf-grad-r)"
            stroke="#450409"
            stroke-width="0.5"
          />
          <!-- Hindwing -->
          <path
            d="M0 11 C3 13, 9 15, 12.5 18 C14 20, 11 22, 7 21 C3 19.5, 1.5 15, 0 11 Z"
            fill="url(#bf-grad-hind-r)"
            stroke="#450409"
            stroke-width="0.5"
          />
          <!-- Delicate Veins -->
          <path d="M1 11 C5 7.5, 10 4.5, 13.5 2.5" stroke="#ffa3ab" stroke-width="0.55" stroke-linecap="round" opacity="0.65" />
          <path d="M2 11 C6.5 10, 11 8.5, 14 6" stroke="#ffa3ab" stroke-width="0.45" stroke-linecap="round" opacity="0.55" />
          <path d="M1 11 C5 13.5, 9 16, 12 18" stroke="#ffa3ab" stroke-width="0.5" stroke-linecap="round" opacity="0.6" />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .bf-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none !important;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.5s ease-out;
    will-change: transform;
    perspective: 500px;
  }

  .bf-follower * {
    pointer-events: none !important;
  }

  .bf-follower[data-active="true"] {
    opacity: 1;
  }

  .bf-rotator {
    position: absolute;
    top: -12px;
    left: -15px;
    width: 30px;
    height: 24px;
    transform-origin: center center;
    will-change: transform;
  }

  .bf-hover {
    display: inline-block;
    will-change: transform;
    transform-style: preserve-3d;
  }

  .bf-body-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 24px;
    transform-style: preserve-3d;
  }

  .bf-wing {
    width: 14px;
    height: 22px;
    display: block;
    transform-style: preserve-3d;
    filter: drop-shadow(0 1px 2px rgba(90, 10, 15, 0.28));
  }

  .bf-wing-left {
    transform-origin: 100% 50%;
    animation: bf-flap-left var(--bf-flap-dur, 0.18s) ease-in-out infinite alternate;
  }

  .bf-wing-right {
    transform-origin: 0% 50%;
    animation: bf-flap-right var(--bf-flap-dur, 0.18s) ease-in-out infinite alternate;
  }

  .bf-body {
    width: 5px;
    height: 22px;
    margin: 0 -1px;
    z-index: 2;
    display: block;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35));
  }

  @keyframes bf-flap-left {
    0% {
      transform: rotateY(0deg) scaleY(1);
    }
    100% {
      transform: rotateY(72deg) scaleY(0.9);
    }
  }

  @keyframes bf-flap-right {
    0% {
      transform: rotateY(0deg) scaleY(1);
    }
    100% {
      transform: rotateY(-72deg) scaleY(0.9);
    }
  }

  /* Disable on touch-only devices */
  @media (hover: none) and (pointer: coarse) {
    .bf-follower {
      display: none !important;
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .bf-follower {
      display: none !important;
    }
  }
</style>

<script>
  (function initButterfly() {
    // Guard against touch devices and reduced motion
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouchOnly = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    if (prefersReduced || isTouchOnly) return;

    const follower = document.querySelector<HTMLElement>('[data-bf-follower]');
    const rotator = document.querySelector<HTMLElement>('[data-bf-rotator]');
    const hoverEl = document.querySelector<HTMLElement>('[data-bf-hover]');
    if (!follower || !rotator || !hoverEl) return;

    let targetX = -100;
    let targetY = -100;
    let currentX = -100;
    let currentY = -100;
    let currentAngle = 0;
    let hasMoved = false;
    let animId: number | null = null;
    let lastFlapDur = 0.18;

    // Slow, natural follow easing factor (tuned for graceful natural lag)
    const followEase = 0.038;
    const offsetDistance = 18;

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX + offsetDistance;
      targetY = e.clientY - offsetDistance;

      if (!hasMoved) {
        hasMoved = true;
        currentX = targetX;
        currentY = targetY;
        follower?.setAttribute('data-active', 'true');
      }
    }

    function onMouseLeave() {
      follower?.removeAttribute('data-active');
    }

    function onMouseEnter() {
      if (hasMoved) {
        follower?.setAttribute('data-active', 'true');
      }
    }

    function loop(now: number) {
      if (hasMoved) {
        const dx = targetX - currentX;
        const dy = targetY - currentY;
        const dist = Math.hypot(dx, dy);

        // Slow, gradual position interpolation
        currentX += dx * followEase;
        currentY += dy * followEase;

        // Wing flapping speed: faster when pursuing cursor, gentle hover flutter when close
        const speedRatio = Math.min(1, dist / 180);
        const targetFlapDur = 0.28 - speedRatio * 0.15; // 0.28s (slow hover) down to 0.13s (rapid flight)
        lastFlapDur += (targetFlapDur - lastFlapDur) * 0.1;
        follower!.style.setProperty('--bf-flap-dur', `${lastFlapDur.toFixed(3)}s`);

        // Organic flight flutter (sideways arc perpendicular to direction of movement)
        let flutterX = 0;
        let flutterY = 0;
        if (dist > 3) {
          const nx = -dy / dist;
          const ny = dx / dist;
          const flutterMag = Math.sin(now * 0.0055) * Math.min(8, dist * 0.08);
          flutterX = nx * flutterMag;
          flutterY = ny * flutterMag;
        }

        // Natural hover bobbing
        const hoverBobX = Math.sin(now * 0.0026) * 4;
        const hoverBobY = Math.cos(now * 0.0021) * 3.5;

        // Smooth rotation without jitter
        if (dist > 4) {
          const targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
          let diffAngle = (targetAngle - currentAngle) % 360;
          if (diffAngle > 180) diffAngle -= 360;
          if (diffAngle < -180) diffAngle += 360;
          // Smooth banking turn
          currentAngle += diffAngle * 0.07;
        } else {
          // Gentle resting drift when stationary
          currentAngle += Math.sin(now * 0.0016) * 0.18;
        }

        const posX = currentX + flutterX;
        const posY = currentY + flutterY;

        follower!.style.transform = `translate3d(${posX.toFixed(1)}px, ${posY.toFixed(1)}px, 0)`;
        rotator!.style.transform = `rotate(${currentAngle.toFixed(1)}deg)`;
        hoverEl!.style.transform = `translate3d(${hoverBobX.toFixed(1)}px, ${hoverBobY.toFixed(1)}px, 0)`;
      }

      animId = requestAnimationFrame(loop);
    }

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);

    const onVisibility = () => {
      if (document.hidden) {
        if (animId) {
          cancelAnimationFrame(animId);
          animId = null;
        }
      } else {
        if (!animId) animId = requestAnimationFrame(loop);
      }
    };
    document.addEventListener('visibilitychange', onVisibility);

    const cleanup = () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mouseleave', onMouseLeave);
      document.removeEventListener('mouseenter', onMouseEnter);
      document.removeEventListener('visibilitychange', onVisibility);
    };
    window.addEventListener('pagehide', cleanup, { once: true });

    animId = requestAnimationFrame(loop);
  })();
</script>
