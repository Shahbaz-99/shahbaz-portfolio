<style>
  .bf-follower {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }

  .bf-follower[data-active='true'] {
    opacity: 1;
  }

  .bf-rotator {
    position: absolute;
    top: -15.5px;
    left: -19px;
    width: 38px;
    height: 31px;
    transform-origin: center;
    will-change: transform;
  }

  .bf-hover {
    width: 38px;
    height: 31px;
    animation: bf-hover 2.8s ease-in-out infinite;
  }

  .bf-butterfly {
    display: block;
    width: 38px;
    height: 31px;
    overflow: visible;
    filter: drop-shadow(0 1px 1.4px rgb(51 5 12 / 38%));
  }

  .bf-wing {
    transform-box: view-box;
    transform-origin: 22px 16px;
    backface-visibility: hidden;
  }

  .bf-fore-left {
    animation: bf-flap-left 190ms cubic-bezier(.45, 0, .55, 1) infinite;
  }

  .bf-fore-right {
    animation: bf-flap-right 190ms cubic-bezier(.45, 0, .55, 1) infinite;
  }

  .bf-hind-left {
    animation: bf-flap-left 205ms cubic-bezier(.45, 0, .55, 1) -24ms infinite;
  }

  .bf-hind-right {
    animation: bf-flap-right 205ms cubic-bezier(.45, 0, .55, 1) -24ms infinite;
  }

  .bf-follower:not([data-active='true']) .bf-wing,
  .bf-follower:not([data-active='true']) .bf-hover,
  .bf-follower:not([data-page-visible='true']) .bf-wing,
  .bf-follower:not([data-page-visible='true']) .bf-hover {
    animation-play-state: paused;
  }

  @keyframes bf-flap-left {
    0%, 100% { transform: rotateY(0deg); }
    50% { transform: rotateY(-66deg); }
  }

  @keyframes bf-flap-right {
    0%, 100% { transform: rotateY(0deg); }
    50% { transform: rotateY(66deg); }
  }

  @keyframes bf-hover {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1.5px); }
  }

  @media (hover: none) and (pointer: coarse), (prefers-reduced-motion: reduce) {
    .bf-follower {
      display: none !important;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touchOnly = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  const follower = document.querySelector<HTMLElement>('[data-bf-follower]');
  const rotator = document.querySelector<HTMLElement>('[data-bf-rotator]');

  if (!reducedMotion && !touchOnly && follower && rotator) {
    const butterfly = follower;
    const wingRotator = rotator;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let currentBank = 0;
    let lastFrame = 0;
    let frameId: number | null = null;
    let hasMoved = false;
    let pointerInside = false;

    const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
    const followTime = 280;

    function keepInViewport() {
      const xMargin = Math.min(28, window.innerWidth / 2);
      const yMargin = Math.min(26, window.innerHeight / 2);
      targetX = clamp(targetX, xMargin, window.innerWidth - xMargin);
      targetY = clamp(targetY, yMargin, window.innerHeight - yMargin);
      currentX = clamp(currentX, xMargin, window.innerWidth - xMargin);
      currentY = clamp(currentY, yMargin, window.innerHeight - yMargin);
    }

    function onResize() {
      keepInViewport();
      if (hasMoved) {
        butterfly.style.transform = `translate3d(${currentX.toFixed(1)}px, ${currentY.toFixed(1)}px, 0)`;
      }
    }

    function onMouseMove(event: MouseEvent) {
      targetX = event.clientX + 14;
      targetY = event.clientY - 10;
      keepInViewport();
      pointerInside = true;

      if (!hasMoved) {
        currentX = targetX;
        currentY = targetY;
        hasMoved = true;
      }

      butterfly.setAttribute('data-active', 'true');
      if (!document.hidden && frameId === null) frameId = requestAnimationFrame(animate);
    }

    function stopAnimation() {
      if (frameId !== null) cancelAnimationFrame(frameId);
      frameId = null;
      lastFrame = 0;
    }

    function onMouseLeave() {
      pointerInside = false;
      butterfly.removeAttribute('data-active');
      stopAnimation();
    }

    function animate(now: number) {
      const elapsed = lastFrame ? Math.min(now - lastFrame, 50) : 16;
      lastFrame = now;
      const easing = 1 - Math.exp(-elapsed / followTime);
      const previousX = currentX;
      currentX += (targetX - currentX) * easing;
      currentY += (targetY - currentY) * easing;

      const speedX = (currentX - previousX) / elapsed;
      const targetBank = clamp(speedX * 13, -18, 18);
      currentBank += (targetBank - currentBank) * (1 - Math.exp(-elapsed / 100));

      butterfly.style.transform = `translate3d(${currentX.toFixed(1)}px, ${currentY.toFixed(1)}px, 0)`;
      wingRotator.style.transform = `rotate(${currentBank.toFixed(1)}deg)`;

      if (Math.abs(targetX - currentX) > 0.2 || Math.abs(targetY - currentY) > 0.2 || Math.abs(currentBank) > 0.1) {
        frameId = requestAnimationFrame(animate);
      } else {
        frameId = null;
        lastFrame = 0;
      }
    }

    function onVisibilityChange() {
      if (document.hidden) {
        butterfly.setAttribute('data-page-visible', 'false');
        stopAnimation();
      } else {
        butterfly.setAttribute('data-page-visible', 'true');
      }

      if (!document.hidden && pointerInside && hasMoved && frameId === null) {
        frameId = requestAnimationFrame(animate);
      }
    }

    function cleanup() {
      stopAnimation();
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('resize', onResize);
      document.removeEventListener('mouseleave', onMouseLeave);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      butterfly.removeAttribute('data-active');
      butterfly.setAttribute('data-page-visible', 'false');
    }

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('resize', onResize);
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('pagehide', cleanup, { once: true });
  }
</script>
