---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/caveat';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import ButterflyCursor from '../components/ButterflyCursor.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; progress?: boolean }
const { progress = false, title, description = site.description } = Astro.props;
const full = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const nav = [
  { href: `${base}#top`, icon: 'home', label: 'Home' },
  { href: `${base}#projects`, icon: 'grid', label: 'Projects' },
  { href: `${base}#experience`, icon: 'briefcase', label: 'Experience' },
  { href: `${base}#research`, icon: 'flask', label: 'Research' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f4ecdd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181817" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={`https://shahbaz-99.github.io${Astro.url.pathname}`} />
    
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://shahbaz-99.github.io${Astro.url.pathname}`} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={`${site.name} Portfolio`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={`https://shahbaz-99.github.io${Astro.url.pathname}`} />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <svg class="doodle" viewBox="0 0 160 90" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" aria-hidden="true">
          <path d="M34 88c2-20 0-34 1-50M72 88c-1-24 2-40 0-56M120 88c2-18 4-28 6-42"/>
          {[[35, 32], [72, 22], [126, 40]].map(([x, y]) => (
            <g transform={`translate(${x} ${y})`}><circle r="2.5"/>{[0, 60, 120, 180, 240, 300].map((a) => <ellipse cx="0" cy="-7" rx="2.6" ry="5" transform={`rotate(${a})`}/>)}</g>
          ))}
        </svg>
        <p>Built with Astro on Cloudflare Pages. <a class="lnk" href={`${base}architecture`}>How it's built</a></p>
        <div class="chips">
          <a class="chip" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
          {site.linkedin && <a class="chip" href={site.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /></a>}
          <a class="chip" href={site.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer"><Icon name="code" /></a>
        </div>
      </footer>
    </div>
    <nav class="dock" aria-label="Main">
      <div class="dock-items">
        {nav.map((n) => <a href={n.href} aria-label={n.label} data-tip={n.label}><Icon name={n.icon} /></a>)}
        <span class="sep" aria-hidden="true"></span>
        <button type="button" data-theme-toggle data-tip="Theme" aria-label="Switch theme"><Icon class="sun" name="sun" /><Icon class="moon" name="moon" /></button>
      </div>
      <div class="ruler" aria-hidden="true"></div>
    </nav>
    <script>import '../scripts/ui';</script>
    <ButterflyCursor />
  </body>
</html>
